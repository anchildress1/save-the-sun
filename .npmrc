# engine-strict disabled: @checkmarkdevtools/commitlint-plugin-rai@0.1.6 (a
# local-only commit-msg tool) pins engines.node to ">=20 <25", which fatally
# blocks installs on this project's Node 26+ target (AGENTS.md) when strict.
# The cap is stale — commitlint runs fine on Node 26. Re-enable once the plugin
# widens its engines range.
engine-strict=false
