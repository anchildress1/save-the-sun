{
	"name": "save-the-sun",
	"private": true,
	"version": "2.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test:coverage": "vitest run --coverage",
		"test": "pnpm run test:unit -- --run && pnpm run test:e2e",
		"test:e2e": "playwright install chromium && playwright test"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@eslint/js": "^10.0.1",
		"@lhci/cli": "0.15.1",
		"@playwright/test": "^1.62.0",
		"@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26.1.2",
		"@vitest/browser": "^4.1.10",
		"@vitest/browser-playwright": "^4.1.10",
		"@vitest/coverage-v8": "^4.1.10",
		"commitlint-plugin-rai": "^1.0.1",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.8.0",
		"lefthook": "^2.1.10",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"secretlint": "^13.0.4",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.1.5",
		"vitest": "^4.1.10",
		"vitest-browser-svelte": "^2.2.1"
	},
	"dependencies": {
		"@google/genai": "^2.15.0",
		"gsap": "^3.15.0"
	},
	"volta": {
		"node": "26.3.0",
		"pnpm": "10.33.1"
	},
	"pnpm": {
		"overrides": {
			"cookie": "^0.7.2",
			"tmp": "^0.2.6",
			"uuid": "^11.1.1",
			"protobufjs@<=7.6.2": ">=7.6.3 <8",
			"js-yaml@<=4.1.1": ">=4.2.0 <5"
		}
	}
}
