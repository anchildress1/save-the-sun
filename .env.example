# Oracle (Gemini) — server-side only, never exposed to the client.
# Get a key at https://aistudio.google.com/apikey and copy this file to .env.
GEMINI_API_KEY=

# Rate limits (optional) — per-minute, per-instance ceilings for the in-memory abuse guard.
# TTS fires a synth REQUEST the instant a line is delivered (not when it plays), so a brisk game queues
# 70+ fresh synths within a window — the SESSION ceiling is sized above a whole game, not a turn. The
# global ceiling is the cross-session abuse backstop; the billing cap is the real spend stop. Lower
# these toward your key's actual RPM if you want the limiter to trip before Google's quota does.
# TTS_SESSION_LIMIT=150
# TTS_GLOBAL_LIMIT=450
# STT_SESSION_LIMIT=15
# STT_GLOBAL_LIMIT=60
# Live Ask turns — REQUEST budgets; each accepted Ask fans out to ~3 Gemini calls, so the effective
# call ceiling is ~3x lower. Sized above real play, not Google's RPM.
# ASK_SESSION_LIMIT=12
# ASK_GLOBAL_LIMIT=48
