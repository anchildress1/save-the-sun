# Oracle (Gemini) — server-side only, never exposed to the client.
# Get a key at https://aistudio.google.com/apikey and copy this file to .env.
GEMINI_API_KEY=

# Rate limits (optional) — per-minute, per-instance ceilings for the in-memory abuse guard.
# Set each to your key's actual model RPM divided by the running instance count, so the limiter
# trips before Google's quota does and one player can't drain the shared key. Defaults track the
# free/preview tier (~10 RPM); raise them on a paid key.
# TTS_SESSION_LIMIT=4
# TTS_GLOBAL_LIMIT=10
# STT_SESSION_LIMIT=4
# STT_GLOBAL_LIMIT=10
# Live Ask turns — REQUEST budgets; each accepted Ask fans out to ~3 Gemini calls, so the effective
# call ceiling is ~3x lower. Sized above real play, not Google's RPM.
# ASK_SESSION_LIMIT=8
# ASK_GLOBAL_LIMIT=24
# /debug voice tee — bounds the unauthenticated demo stream's events per minute.
# VOICE_DEBUG_SESSION_LIMIT=30
# VOICE_DEBUG_GLOBAL_LIMIT=120
