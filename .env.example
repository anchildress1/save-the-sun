# Oracle (Gemini) — server-side only, never exposed to the client.
# Get a key at https://aistudio.google.com/apikey and copy this file to .env.
GEMINI_API_KEY=

# /debug log exposure (S8). verbose = everything incl. the secret + raw Gemini I/O;
# demo = screen-shareable subset (no secret, no raw model I/O); off = view disabled.
# Unset defaults to verbose in dev, off in prod — so leaving this commented out gives
# full local visibility AND a safe deployed build. Uncomment only to override (e.g.
# 'demo' for a screen-share). Never ship 'verbose' on a public deployment.
# DEBUG_LOG=verbose
