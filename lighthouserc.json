{
	"ci": {
		"collect": {
			"startServerCommand": "pnpm run build && pnpm exec vite preview --port 4321",
			"startServerReadyPattern": "Local:",
			"startServerReadyTimeout": 120000,
			"url": ["http://localhost:4321/"],
			"numberOfRuns": 1
		},
		"upload": {
			"target": "filesystem",
			"outputDir": ".lighthouseci"
		}
	}
}
